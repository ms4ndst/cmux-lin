# Upstream and toolchain pins for the cmux Linux build.
# Sourced by scripts/*.sh. Change these to rebuild a different revision.

# manaflow-ai/cmux commit (superproject)
export CMUX_COMMIT="14d9299606a6f04a77e14bf319e71171698741bd"
export CMUX_REPO="https://github.com/manaflow-ai/cmux"

# ghostty submodule commit recorded by the pinned superproject.
# 20-fetch-source.sh verifies the checked-out submodule against this pin.
export GHOSTTY_COMMIT="ef4f1570d62117ebc51e3b0f07ad4f34032267b6"

# Zig toolchain used to build libghostty-vt.a
export ZIG_VERSION="0.16.0"
export ZIG_TARBALL="https://ziglang.org/download/0.16.0/zig-x86_64-linux-0.16.0.tar.xz"
export ZIG_SHA256="70e49664a74374b48b51e6f3fdfbf437f6395d42509050588bd49abe52ba3d00"
export ZIG_INSTALL_DIR="${ZIG_INSTALL_DIR:-$HOME/opt/zig-x86_64-linux-0.16.0}"

# Rust toolchain (rustup profile minimal)
export RUST_TOOLCHAIN="stable"
