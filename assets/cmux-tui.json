    {
      "id": "quit-session",
      "name": "Quit session (stop server)",
      "keys": "Q",
      "run": [
        "sh",
        "-c",
        "exec cmux server stop --socket \"$CMUX_TUI_SOCKET\""
      ]
    },
    {
      "id": "cycle-theme",
